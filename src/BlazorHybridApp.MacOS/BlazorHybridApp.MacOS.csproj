<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.example.BlazorHybridApp</ApplicationId>
    <ApplicationTitle>BlazorHybridApp</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorHybridApp.Rcl\BlazorHybridApp.Rcl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <BundleResource Include="..\BlazorHybridApp.Rcl\HostPage\index.html" Link="wwwroot\index.html" />
  </ItemGroup>

</Project>
